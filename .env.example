# Database Configuration
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pepdf

# JWT Configuration
# Generate a secure key: openssl rand -hex 32
JWT_SECRET_KEY=your-128-character-hex-secret-key-here
JWT_ALGORITHM=HS256

# Token Expiration (in days)
# Set to null for indefinite expiration (no exp claim)
ACCESS_TOKEN_EXPIRE_DAYS=null
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Configuration
# Frontend URL for development
FRONTEND_URL=http://localhost:3000
# Allowed origins for CORS (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
# Allow credentials in CORS requests (for cookies)
CORS_ALLOW_CREDENTIALS=true
